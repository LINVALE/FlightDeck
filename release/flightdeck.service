[Unit]
Description=FlightDeck — display faces for every Roon zone
Documentation=https://github.com/LINVALE
# Roon discovery and mDNS both need the network to be up and addressed.
After=network-online.target
Wants=network-online.target
# A crash loop must not hammer Roon's discovery: give up and stay down.
# Sized against RestartSec=5, so a genuinely crashing service trips this in about
# a minute — while leaving room for the hand-restarts that development needs.
# Tighter values (5 in 300 s) stopped the service mid-session on 2026-08-25 and
# needed `systemctl reset-failed` to clear, which is a poor trade for the safety.
# These are [Unit] keys — systemd ignores them silently under [Service].
StartLimitIntervalSec=120
StartLimitBurst=12

[Service]
Type=simple
User=peter
Group=peter
WorkingDirectory=/home/peter/dev/FlightDeck
# nvm-managed node: an absolute path, because a service has no nvm shims and no
# login shell. ⚠️ This path carries the version — update it after a node upgrade
# (`readlink -f "$(which node)"`), or the unit fails to start.
ExecStart=/home/peter/.nvm/versions/node/v24.13.1/bin/node /home/peter/dev/FlightDeck/src/main.ts

# ── The point of this unit ──────────────────────────────────────────────────
# Bind :80 as a NON-ROOT user. Ambient capabilities survive NoNewPrivileges,
# which is why this is the right tool and `setcap` on /usr/bin/node is the wrong
# one — that would grant the capability to every node process on the box,
# including the RHEOS fleet.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

Environment=FLIGHTDECK_DATA=/home/peter/dev/FlightDeck/data
Environment=FLIGHTDECK_NAME=flightdeck
# Browse changes the registration Roon holds on file, so enabling it parks the
# extension until a human re-enables it in Roon Settings. Opt in deliberately.
Environment=FLIGHTDECK_BROWSE=0

Restart=on-failure
RestartSec=5

StandardOutput=append:/home/peter/dev/FlightDeck/logs/flightdeck.log
StandardError=append:/home/peter/dev/FlightDeck/logs/flightdeck.log

# ── Hardening. Deliberately NOT PrivateNetwork/NetworkNamespacePath: mDNS needs
# the real LAN, and multicast does not cross a namespace boundary. ──
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/peter/dev/FlightDeck/data /home/peter/dev/FlightDeck/logs
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
