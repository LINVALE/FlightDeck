{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FlightDeck: Restart service (sudo)",
      "detail": "Required after ANY change under src/. Changes under assets/ only need a browser refresh.",
      "type": "shell",
      "command": "sudo systemctl restart flightdeck && sleep 3 && ./flightdeck-launch.sh status",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "FlightDeck: Service log",
      "type": "shell",
      "command": "journalctl -u flightdeck -f -n 40",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "FlightDeck: Start",
      "type": "shell",
      "command": "./flightdeck-launch.sh start",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Only when the systemd service is disabled \u2014 it refuses otherwise, and binds :8440 not :80."
